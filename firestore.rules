rules_version = '2';

// Nom : firestore.rules
// Chemin : firestore.rules
// Rôle : règles de sécurité Cloud Firestore de LUMA (deny by default).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- users/{userId} ---
    match /users/{userId} {
      // Lecture par les utilisateurs connectés (annuaire / recherche de contacts).
      allow read: if isSignedIn();

      // Écriture uniquement sur son propre profil, et jamais de champ privilégié.
      allow create, update: if isSelf(userId)
        && request.resource.data.uid == userId
        && !request.resource.data.keys().hasAny(['role', 'admin', 'isAdmin', 'claims'])
        && !('password' in request.resource.data);

      allow delete: if false;
    }

    // --- conversations/{conversationId} ---
    match /conversations/{conversationId} {
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      allow read: if isMember();

      // Création : uniquement une conversation dont on fait partie (2 membres max).
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      // Mise à jour : membres uniquement, sans modifier la liste des participants.
      allow update: if isMember()
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      // --- messages/{messageId} ---
      match /messages/{messageId} {
        function inConversation() {
          return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }

        allow read: if inConversation();

        allow create: if inConversation()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        // Seule évolution autorisée pour un tiers : ajouter son uid à readBy.
        allow update: if inConversation()
          && request.resource.data.text == resource.data.text
          && request.resource.data.senderId == resource.data.senderId;

        allow delete: if inConversation() && resource.data.senderId == request.auth.uid;
      }
    }

    // Tout le reste est refusé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
