# Nom : .env.example
# Chemin : .env.example
# Rôle : modèle de configuration. Copiez-le en .env.local (jamais commité).

# Configuration web Firebase (valeurs publiques, protégées par les Security Rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

